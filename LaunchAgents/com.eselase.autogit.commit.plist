<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.eselase.autogit.commit</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/macbookpro/Projects/auto-git-commit-push-script/commit_changes.sh</string>
    </array>

    <!-- Every 30 minutes, on the clock (:00 and :30) -->
    <key>StartCalendarInterval</key>
    <array>
        <dict><key>Minute</key><integer>0</integer></dict>
        <dict><key>Minute</key><integer>30</integer></dict>
    </array>

    <!-- Also run once shortly after login/load -->
    <key>RunAtLoad</key>
    <true/>

    <key>StandardOutPath</key>
    <string>/Users/macbookpro/Library/Logs/auto-git/commit.launchd.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/macbookpro/Library/Logs/auto-git/commit.launchd.log</string>
</dict>
</plist>
